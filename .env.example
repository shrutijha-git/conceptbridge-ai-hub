APP_NAME=ConceptBridge API
APP_ENV=development
API_PREFIX=/api/v1
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=your_mysql_password
MYSQL_DATABASE=conceptbridge

# Explicit local mock mode. No real AI requests or automatic mock fallback.
DEFAULT_PROVIDER=mock
ENABLE_MOCK=true
# To use actual AI: DEFAULT_PROVIDER=auto and configure at least one key below.
AUTO_PROVIDER_ORDER=gemini,openai,anthropic
PROVIDER_TIMEOUT_SECONDS=25
MAX_OUTPUT_TOKENS=1600
CONTEXT_MAX_BYTES=26000
RECENT_MESSAGE_COUNT=8
STORAGE_DIR=storage
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Server-side developer API credentials. Consumer chatbot logins are not used.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-luna
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.7-flash
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5
