  "components": {
    "schemas": {
      "AttemptRequest": {
        "properties": {
          "session_id": {
            "type": "string",
            "format": "uuid",
            "title": "Session Id"
          },
          "question_id": {
            "type": "string",
            "maxLength": 100,
            "minLength": 1,
            "title": "Question Id"
          },
          "answer": {
            "type": "string",
            "maxLength": 12000,
            "minLength": 1,
            "title": "Answer"
          }
        },
        "type": "object",
        "required": [
          "session_id",
          "question_id",
          "answer"
        ],
        "title": "AttemptRequest"
      },
      "Body_data_practice_api_v1_practice_data_post": {
        "properties": {
          "file": {
            "type": "string",
            "format": "binary",
            "title": "File"
          },
          "date_column": {
            "type": "string",
            "maxLength": 255,
            "minLength": 1,
            "title": "Date Column",
            "default": "date"
          },
          "value_column": {
            "type": "string",
            "maxLength": 255,
            "minLength": 1,
            "title": "Value Column",
            "default": "sales"
          },
          "category_column": {
            "type": "string",
            "maxLength": 255,
            "minLength": 1,
            "title": "Category Column",
            "default": "region"
          },
          "grouping": {
            "type": "string",
            "title": "Grouping"
          },
          "aggregation": {
            "type": "string",
            "title": "Aggregation"
          },
          "chart": {
            "type": "string",
            "title": "Chart"
          },
          "session_id": {
            "anyOf": [
              {
                "type": "string",
                "format": "uuid"
              },
              {
                "type": "null"
              }
            ],
            "title": "Session Id"
          }
        },
        "type": "object",
        "required": [
          "file",
          "grouping",
          "aggregation",
          "chart"
        ],
        "title": "Body_data_practice_api_v1_practice_data_post"
      },
      "Body_upload_document_api_v1_documents_post": {
        "properties": {
          "session_id": {
            "type": "string",
            "format": "uuid",
            "title": "Session Id"
          },
          "file": {
            "type": "string",
            "format": "binary",
            "title": "File"
          }
        },
        "type": "object",
        "required": [
          "session_id",
          "file"
        ],
        "title": "Body_upload_document_api_v1_documents_post"
      },
      "ChatRequest": {
        "properties": {
          "session_id": {
            "type": "string",
            "format": "uuid",
            "title": "Session Id"
          },
          "request_id": {
            "anyOf": [
              {
                "type": "string",
                "format": "uuid"
              },
              {
                "type": "null"
              }
            ],
            "title": "Request Id"
          },
          "message": {
            "type": "string",
            "maxLength": 12000,
            "minLength": 1,
            "title": "Message"
          },
          "provider": {
            "type": "string",
            "enum": [
              "auto",
              "mock",
              "openai",
              "gemini",
              "anthropic"
            ],
            "title": "Provider",
            "default": "auto"
          },
          "allow_fallback": {
            "type": "boolean",
            "title": "Allow Fallback",
            "default": false
          },
          "mode": {
            "type": "string",
            "enum": [
              "understand",
              "practise",
              "code"
            ],
            "title": "Mode",
            "default": "understand"
          }
        },
        "type": "object",
        "required": [
          "session_id",
          "message"
        ],
        "title": "ChatRequest"
      },
      "ChatResponse": {
        "properties": {
          "session_id": {
            "type": "string",
            "title": "Session Id"
          },
          "request_id": {
            "type": "string",
            "title": "Request Id"
          },
          "provider_requested": {
            "type": "string",
            "title": "Provider Requested"
          },
          "provider_used": {
            "type": "string",
            "title": "Provider Used"
          },
          "previous_provider": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Previous Provider"
          },
          "provider_changed": {
            "type": "boolean",
            "title": "Provider Changed"
          },
          "fallback_used": {
            "type": "boolean",
            "title": "Fallback Used"
          },
          "is_mock": {
            "type": "boolean",
            "title": "Is Mock"
          },
          "response": {
            "type": "string",
            "title": "Response"
          },
          "turn_no": {
            "type": "integer",
            "title": "Turn No"
          },
          "route_events": {
            "items": {
              "additionalProperties": true,
              "type": "object"
            },
            "type": "array",
            "title": "Route Events"
          },
          "usage": {
            "additionalProperties": true,
            "type": "object",
            "title": "Usage"
          },
          "context": {
            "additionalProperties": true,
            "type": "object",
            "title": "Context"
          }
        },
        "type": "object",
        "required": [
          "session_id",
          "request_id",
          "provider_requested",
          "provider_used",
          "previous_provider",
          "provider_changed",
          "fallback_used",
          "is_mock",
          "response",
          "turn_no",
          "route_events",
          "usage",
          "context"
        ],
        "title": "ChatResponse"
      },
      "DemoSessionRequest": {
        "properties": {
          "degree": {
            "type": "string",
            "enum": [
              "MCA",
              "BCA",
              "MBA",
              "BBA"
            ],
            "title": "Degree",
            "default": "MCA"
          },
          "subject": {
            "type": "string",
            "maxLength": 150,
            "minLength": 1,
            "title": "Subject",
            "default": "DBMS"
          },
          "topic": {
            "type": "string",
            "maxLength": 255,
            "minLength": 1,
            "title": "Topic",
            "default": "Third Normal Form"
          }
        },
        "type": "object",
        "title": "DemoSessionRequest"
      },
      "DemoSessionResponse": {
        "properties": {
          "session_id": {
            "type": "string",
            "title": "Session Id"
          },
          "user_id": {
            "type": "string",
            "title": "User Id"
          },
          "course_id": {
            "type": "string",
            "title": "Course Id"
          }
        },
        "type": "object",
        "required": [
          "session_id",
          "user_id",
          "course_id"
        ],
        "title": "DemoSessionResponse"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "MemoryPatch": {
        "properties": {
          "learning_objective": {
            "type": "string",
            "maxLength": 600,
            "title": "Learning Objective",
            "default": ""
          },
          "current_question": {
            "type": "string",
            "maxLength": 1000,
            "title": "Current Question",
            "default": ""
          },
          "known_concepts": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "maxItems": 15,
            "title": "Known Concepts"
          },
          "weak_concepts": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "maxItems": 15,
            "title": "Weak Concepts"
          },
          "misconceptions": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "maxItems": 15,
            "title": "Misconceptions"
          },
          "explanation_preference": {
            "type": "string",
            "maxLength": 200,
            "title": "Explanation Preference",
            "default": "Worked examples"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "title": "MemoryPatch"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
